# CineBox Environment Variables (Copy to .env for local development)
# Never commit real API keys or service_role keys to source control.

# 1. Direct TMDB API v3 Key & v4 Read Access Token (Bearer)
VITE_TMDB_API_KEY=""
VITE_TMDB_READ_ACCESS_TOKEN=""

# 2. Supabase Project URL & Public Anon Key (RLS-protected)
VITE_SUPABASE_URL="https://myeammfiwahmmemkoqif.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# 3. Optional Deployed Server-Side TMDB Proxy (Supabase Edge Function)
VITE_TMDB_PROXY_URL="https://myeammfiwahmmemkoqif.supabase.co/functions/v1/tmdb-proxy"

# 4. Deployed Server-Side CORS Proxy (Supabase Edge Function)
# Format: https://myeammfiwahmmemkoqif.supabase.co/functions/v1/cors-proxy?target={original_url}
VITE_CORS_PROXY_URL="https://myeammfiwahmmemkoqif.supabase.co/functions/v1/cors-proxy"

# 5. Optional YouTube Data API v3 Key (Pakistani Dramas feed)
VITE_YOUTUBE_API_KEY=""

# 6. Gemini API Key (Platform Default)
GEMINI_API_KEY=""
APP_URL=""
