# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_TMDB_API_KEY: TMDb API v3 Key for live movie metadata fetching
VITE_TMDB_API_KEY=""

# VITE_SUPABASE_URL: Supabase Project URL for movie_links and app_config tables
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Supabase Public Anon Key
VITE_SUPABASE_ANON_KEY=""

# VITE_YOUTUBE_API_KEY: YouTube Data API v3 Key for Official Pakistani Dramas (HUM TV, ARY Digital, Har Pal Geo, GEO TV)
VITE_YOUTUBE_API_KEY=""

